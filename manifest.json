{
  "manifest_version": 3,
  "name": "Profile Lock",
  "version": "1.3.0",
  "description": "ล็อกโปรไฟล์ Chrome ด้วยรหัสผ่าน ป้องกันคนอื่นเปิดดูอีเมลและเว็บที่ล็อกอินไว้",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "idle", "declarativeNetRequest"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Profile Lock",
    "default_popup": "popup.html"
  },
  "options_page": "setup.html",
  "incognito": "not_allowed",
  "commands": {
    "lock-now": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "ล็อกโปรไฟล์ทันที"
    }
  }
}
